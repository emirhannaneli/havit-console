{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Havit Console",
  "version": "0.1.0",
  "identifier": "io.github.havitconsole.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Havit Console",
        "width": 1240,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Havit Console Contributors",
    "shortDescription": "Control center for Havit keyboards and headsets",
    "longDescription": "Independent, open-source control center for the Havit KB884L keyboard and Fuxi-H7 headset.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Havit Console"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0RURCRUJDMkE3NTJEMEEKUldRS0xYVXF2TDd0SkV6U0ZxQ2tpejk0OUN0MDFlTElCajhQRlROVHBxL2VkQm9sWE9OMDUwTTYK",
      "endpoints": [
        "https://github.com/emirhannaneli/havit-console/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
